
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COORDINATOR
  COURIER
  PARTNER
}

enum ParcelStatus {
  RECEIVED
  REGISTERED
  AWAITING_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(COURIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs AuditLog[]
  deliveryAttempts DeliveryAttempt[]

  registeredParcels Parcel[] @relation("ParcelRegisteredBy")
  assignedParcels   Parcel[] @relation("ParcelAssignedCourier")
  statusChanges     ParcelStatusHistory[]
    agencyId      String?
  partnerAgency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
}

model Parcel {
  id                    String       @id @default(uuid())
  trackingNumber        String       @unique
  externalTrackingNumber String?
  sendingAgency         String?
  agencyId String?
agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  recipientName         String
  recipientPhone        String
  recipientAddress      String?
  deliveryInstructions  String?
  description           String?
  conditionOnArrival    String?
  sealNumber            String?
  status                ParcelStatus @default(RECEIVED)
  deliveryAttempts DeliveryAttempt[]

  registeredById String
  registeredBy   User   @relation("ParcelRegisteredBy", fields: [registeredById], references: [id])

  assignedCourierId String?
  assignedCourier   User?   @relation("ParcelAssignedCourier", fields: [assignedCourierId], references: [id])

  receivedAt DateTime  @default(now())
  deliveredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  unclaimedAt DateTime?
  deliveredToName  String?
deliveryProofNote String?

  statusHistory ParcelStatusHistory[]
photos        ParcelPhoto[]
deliveryOtps  DeliveryOtp[]
  deliveryZone             String?
  recipientConfirmationToken String?   @unique
recipientConfirmedAt       DateTime?
preferredDeliveryDate      DateTime?
preferredTimeSlot          String?
  deliveryFee              Int?
  isExpress                Boolean @default(false)
  isBulky                  Boolean @default(false)
  isCashOnDelivery         Boolean @default(false)
  isSecondPresentation     Boolean @default(false)

  @@index([status])
  @@index([recipientPhone])
  @@index([assignedCourierId])
}

model ParcelStatusHistory {
  id        String       @id @default(uuid())
  parcelId  String
  status    ParcelStatus
  note      String?
  changedById String
  changedBy User         @relation(fields: [changedById], references: [id])
  changedAt DateTime     @default(now())

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId, changedAt])
}

model ParcelPhoto {
  id        String   @id @default(uuid())
  parcelId  String
  url       String
  purpose   String?
  createdAt DateTime @default(now())

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId])
}


model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}


model Agency {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  city        String?
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  holdingPeriodDays Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
    partnerUsers User[]

  parcels     Parcel[]

  @@index([name])
  @@index([city])
}
model DeliveryOtp {
  id           String    @id @default(uuid())
  parcelId     String
  codeHash     String
  expiresAt    DateTime
  verifiedAt   DateTime?
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId, createdAt])
  @@index([expiresAt])
}
model DeliveryAttempt {
  id            String   @id @default(uuid())
  parcelId      String
  courierId     String?
  attemptNumber Int
  outcome       String
  failureReason String?
  notes         String?
  attemptedAt   DateTime @default(now())
  rescheduledAt DateTime?

  parcel  Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  courier User?  @relation(fields: [courierId], references: [id], onDelete: SetNull)

  @@unique([parcelId, attemptNumber])
  @@index([parcelId, attemptedAt])
  @@index([courierId])
  recipientChoice    String?
relayPointDetails  String?
resolvedAt         DateTime?
}
model PricingRule {
  id                         String   @id @default(uuid())
  zone                       String   @unique
  baseFee                    Int
  expressSurcharge           Int      @default(0)
  bulkySurcharge             Int      @default(0)
  cashOnDeliverySurcharge    Int      @default(0)
  secondPresentationSurcharge Int      @default(0)
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([isActive])
}